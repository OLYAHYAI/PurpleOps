<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.USE_BIOMETRIC" />

    <application
        android:allowBackup="false"
        android:label="PurpleOps proto Slint"
        android:theme="@style/Proto">

        <!-- Slint dessine toute l'activité. hasCode reste vrai : la sous-classe
             Kotlin porte les API Android appelées depuis Rust. -->
        <activity
            android:name=".ProtoActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|keyboard|density|uiMode"
            android:windowSoftInputMode="adjustResize">
            <meta-data android:name="android.app.lib_name" android:value="proto" />
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity android:name=".WebActivity" android:exported="false" />
    </application>
</manifest>
