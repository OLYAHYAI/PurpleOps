<?xml version="1.0" encoding="utf-8"?>
<!-- Aucune donnée de l'appli ne quitte le téléphone : ni sauvegarde cloud, ni
     transfert d'appareil à appareil (réglages, empreintes TLS, secrets chiffrés
     dont la clé Keystore ne serait de toute façon pas transférée). -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
