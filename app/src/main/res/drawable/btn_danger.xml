<?xml version="1.0" encoding="utf-8"?>
<!-- Action destructrice / offensive : toujours isolée, 56 dp. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false">
        <shape android:shape="rectangle">
            <solid android:color="#33FF4D5E" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item android:state_pressed="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/danger_strong" />
            <corners android:radius="14dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <gradient android:startColor="#FF5D6C" android:endColor="@color/danger_strong" android:angle="270" />
            <corners android:radius="14dp" />
            <stroke android:width="1dp" android:color="@color/danger" />
        </shape>
    </item>
</selector>
