<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <solid android:color="#CC07090D" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="@color/accent" />
            <padding android:left="14dp" android:top="12dp" android:right="14dp" android:bottom="12dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#CC07090D" />
            <corners android:radius="12dp" />
            <stroke android:width="1dp" android:color="@color/border" />
            <padding android:left="14dp" android:top="12dp" android:right="14dp" android:bottom="12dp" />
        </shape>
    </item>
</selector>
