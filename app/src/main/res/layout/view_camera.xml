<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingBottom="4dp" android:text="Caméra — Nikon P900" android:textColor="@color/neon"
        android:textStyle="bold" android:textSize="18sp" android:letterSpacing="0.05" />

    <TextView android:id="@+id/camStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:paddingBottom="8dp" android:text="—" android:textColor="@color/muted" android:textSize="12sp" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingBottom="8dp">
        <TextView android:id="@+id/camProbe" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:background="@drawable/btn_neon" android:gravity="center" android:paddingTop="10dp" android:paddingBottom="10dp"
            android:text="TESTER" android:textColor="@color/neon" android:textSize="13sp" android:layout_marginEnd="8dp" />
        <TextView android:id="@+id/camStart" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:background="@drawable/btn_accent" android:gravity="center" android:paddingTop="10dp" android:paddingBottom="10dp"
            android:text="VISÉE" android:textColor="@color/text" android:textStyle="bold" android:textSize="13sp" android:layout_marginEnd="8dp" />
        <TextView android:id="@+id/camStop" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:background="@drawable/btn_neon" android:gravity="center" android:paddingTop="10dp" android:paddingBottom="10dp"
            android:text="ARRÊTER" android:textColor="@color/danger" android:textSize="13sp" />
    </LinearLayout>

    <WebView android:id="@+id/camWeb" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="2" android:visibility="gone" />

    <ScrollView android:id="@+id/camLogScroll" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:background="@drawable/bg_console" android:padding="10dp" android:layout_marginTop="6dp">
        <TextView android:id="@+id/camLog" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="monospace" android:textSize="11sp" android:textColor="@color/console_text"
            android:textIsSelectable="true" />
    </ScrollView>
</LinearLayout>
