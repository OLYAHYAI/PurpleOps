<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:scrollbars="none">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Reglages"
            android:textColor="@color/text" android:textStyle="bold" android:textSize="20sp" android:paddingBottom="12dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Connexion Wazuh (via Tailscale)"
            android:textColor="@color/neon" android:textSize="13sp" android:paddingBottom="6dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hote (IP Tailscale du manager)" android:textColor="@color/muted" android:textSize="11sp" />
        <EditText android:id="@+id/cfgHost" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_input" android:hint="100.80.92.77" android:textColorHint="@color/muted"
            android:textColor="@color/text" android:inputType="text" android:maxLines="1" android:importantForAutofill="no" android:layout_marginBottom="8dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="API Wazuh — utilisateur" android:textColor="@color/muted" android:textSize="11sp" />
        <EditText android:id="@+id/cfgApiUser" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_input" android:hint="wazuh-wui" android:textColorHint="@color/muted"
            android:textColor="@color/text" android:inputType="text" android:maxLines="1" android:importantForAutofill="no" android:layout_marginBottom="8dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="API Wazuh — mot de passe" android:textColor="@color/muted" android:textSize="11sp" />
        <EditText android:id="@+id/cfgApiPass" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_input" android:textColor="@color/text" android:inputType="textPassword"
            android:maxLines="1" android:importantForAutofill="no" android:layout_marginBottom="8dp" />

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Indexer — utilisateur" android:textColor="@color/muted" android:textSize="11sp" />
        <EditText android:id="@+id/cfgIdxUser" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_input" android:hint="admin" android:textColorHint="@color/muted"
            android:textColor="@color/text" android:inputType="text" android:maxLines="1" android:importantForAutofill="no" android:layout_marginBottom="8dp" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Indexer — mot de passe" android:textColor="@color/muted" android:textSize="11sp" />
        <EditText android:id="@+id/cfgIdxPass" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:background="@drawable/bg_input" android:textColor="@color/text" android:inputType="textPassword"
            android:maxLines="1" android:importantForAutofill="no" android:layout_marginBottom="12dp" />

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
            <TextView android:id="@+id/cfgSave" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:background="@drawable/btn_accent" android:gravity="center" android:paddingTop="12dp" android:paddingBottom="12dp"
                android:text="ENREGISTRER" android:textStyle="bold" android:textColor="#0B0A12" android:textSize="13sp" android:layout_marginEnd="8dp" />
            <TextView android:id="@+id/cfgTest" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:background="@drawable/btn_neon" android:gravity="center" android:paddingTop="12dp" android:paddingBottom="12dp"
                android:text="TESTER" android:textColor="@color/neon" android:textSize="13sp" />
        </LinearLayout>

        <TextView android:id="@+id/cfgStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="" android:textColor="@color/muted" android:textSize="12sp" android:fontFamily="monospace" android:paddingTop="10dp" />

        <TextView android:id="@+id/cfgVersion" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="" android:textColor="@color/muted" android:textSize="11sp" android:paddingTop="18dp" />
        <TextView android:id="@+id/cfgCheckUpdate" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Chercher une mise a jour" android:textColor="@color/cyan" android:textSize="13sp" android:paddingTop="8dp" />
    </LinearLayout>
</ScrollView>
