<?xml version="1.0" encoding="utf-8"?>
<!-- Réglages (Neon Ops) : une carte par service, pastille d'état + titre Space Grotesk.
     Tous les identifiants sont conservés (MainActivity, McpPanel, WolPanel). -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:scrollbars="none">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
        android:paddingBottom="16dp">

        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="CONFIGURATION · SECRETS CHIFFRÉS" android:textColor="@color/muted" android:textSize="11sp"
            android:fontFamily="@font/jetbrains_mono" android:letterSpacing="0.12" />
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Réglages" android:textColor="@color/text" android:textSize="22sp"
            android:fontFamily="@font/space_grotesk" android:textStyle="bold" android:paddingBottom="14dp" />

        <!-- Wazuh -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:background="@drawable/card" android:padding="16dp" android:layout_marginBottom="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
                android:gravity="center_vertical" android:paddingBottom="4dp">
                <View android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/dot_ok" android:layout_marginEnd="10dp" />
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Wazuh"
                    android:textColor="@color/text" android:textSize="15sp" android:fontFamily="@font/space_grotesk" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="via Tailscale · CA épinglée"
                    android:textColor="@color/muted" android:textSize="10.5sp" android:fontFamily="@font/jetbrains_mono" />
            </LinearLayout>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Hôte (IP Tailscale du manager)"
                android:textColor="@color/muted" android:textSize="12sp" android:paddingTop="10dp" android:paddingBottom="6dp" />
            <EditText android:id="@+id/cfgHost" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/bg_input" android:textColor="@color/text" android:textSize="13sp" android:fontFamily="@font/jetbrains_mono" android:hint="100.80.92.77" android:textColorHint="@color/faint"
                android:inputType="text" android:maxLines="1" android:importantForAutofill="no" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginEnd="8dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="API · utilisateur"
                        android:textColor="@color/muted" android:textSize="12sp" android:paddingTop="10dp" android:paddingBottom="6dp" />
                    <EditText android:id="@+id/cfgApiUser" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:background="@drawable/bg_input" android:textColor="@color/text" android:textSize="13sp" android:fontFamily="@font/jetbrains_mono" android:hint="purpleops-app" android:textColorHint="@color/faint"
                        android:inputType="text" android:maxLines="1" android:importantForAutofill="no" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="API · mot de passe"
                        android:textColor="@color/muted" android:textSize="12sp" android:paddingTop="10dp" android:paddingBottom="6dp" />
                    <EditText android:id="@+id/cfgApiPass" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:background="@drawable/bg_input" android:textColor="@color/text" android:textSize="13sp"
                        android:inputType="textPassword" android:maxLines="1" android:importantForAutofill="no" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginEnd="8dp">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Indexer · utilisateur"
                        android:textColor="@color/muted" android:textSize="12sp" android:paddingTop="10dp" android:paddingBottom="6dp" />
                    <EditText android:id="@+id/cfgIdxUser" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:background="@drawable/bg_input" android:textColor="@color/text" android:textSize="13sp" android:fontFamily="@font/jetbrains_mono" android:hint="purpleops-app" android:textColorHint="@color/faint"
                        android:inputType="text" android:maxLines="1" android:importantForAutofill="no" />
                </LinearLayout>
                <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
                    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Indexer · mot de passe"
                        android:textColor="@color/muted" android:textSize="12sp" android:paddingTop="10dp" android:paddingBottom="6dp" />
                    <EditText android:id="@+id/cfgIdxPass" android:layout_width="match_parent" android:layout_height="wrap_content"
                        android:background="@drawable/bg_input" android:textColor="@color/text" android:textSize="13sp"
                        android:inputType="textPassword" android:maxLines="1" android:importantForAutofill="no" />
                </LinearLayout>
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="14dp">
                <TextView android:id="@+id/cfgSave" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:background="@drawable/btn_accent" android:gravity="center" android:minHeight="48dp" android:layout_marginEnd="8dp"
                    android:text="Enregistrer" android:textStyle="bold" android:textColor="@color/bg" android:textSize="13sp" />
                <TextView android:id="@+id/cfgTest" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:background="@drawable/btn_neon" android:gravity="center" android:minHeight="48dp"
                    android:text="Tester" android:textStyle="bold" android:textColor="@color/accent_on" android:textSize="13sp" />
            </LinearLayout>
            <TextView android:id="@+id/cfgStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="" android:textColor="@color/text_soft" android:textSize="11.5sp" android:fontFamily="@font/jetbrains_mono" android:paddingTop="10dp" />
        </LinearLayout>

        <!-- Serveur MCP PurpleOps (Claude Desktop via Tailscale) -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:background="@drawable/card" android:padding="16dp" android:layout_marginBottom="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
                android:gravity="center_vertical">
                <View android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/dot_ok" android:layout_marginEnd="10dp" />
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Serveur MCP PurpleOps"
                    android:textColor="@color/text" android:textSize="15sp" android:fontFamily="@font/space_grotesk" android:textStyle="bold" />
                <TextView android:id="@+id/mcpToggle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                    android:background="@drawable/btn_accent" android:gravity="center" android:minHeight="40dp"
                    android:paddingStart="16dp" android:paddingEnd="16dp"
                    android:text="Démarrer" android:textStyle="bold" android:textColor="@color/bg" android:textSize="12.5sp" />
            </LinearLayout>
            <TextView android:id="@+id/mcpStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="—" android:textColor="@color/muted" android:textSize="11.5sp" android:fontFamily="@font/jetbrains_mono" android:paddingTop="8dp" />
            <com.google.android.material.materialswitch.MaterialSwitch android:id="@+id/mcpAuto"
                android:layout_width="match_parent" android:layout_height="wrap_content" android:minHeight="52dp"
                android:text="Démarrer à l'ouverture de PurpleOps" android:textColor="@color/text" android:textSize="13sp" />
            <TextView android:id="@+id/mcpUpdate" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/btn_ghost" android:gravity="center" android:minHeight="46dp"
                android:text="Mettre à jour depuis GitHub (config et jeton conservés)" android:textColor="@color/text_soft"
                android:textStyle="bold" android:textSize="12.5sp" android:paddingStart="12dp" android:paddingEnd="12dp" />
        </LinearLayout>

        <!-- Réveil des nœuds par wol-pi (Wake-on-LAN) + webhook radio -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical"
            android:background="@drawable/card" android:padding="16dp" android:layout_marginBottom="12dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
                android:gravity="center_vertical" android:paddingBottom="4dp">
                <View android:layout_width="8dp" android:layout_height="8dp" android:background="@drawable/dot_ok" android:layout_marginEnd="10dp" />
                <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="wol-pi · réveil et radio"
                    android:textColor="@color/text" android:textSize="15sp" android:fontFamily="@font/space_grotesk" android:textStyle="bold" />
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Wake-on-LAN · WIDS"
                    android:textColor="@color/muted" android:textSize="10.5sp" android:fontFamily="@font/jetbrains_mono" />
            </LinearLayout>
            <TextView android:id="@+id/wolStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="—" android:textColor="@color/muted" android:textSize="11.5sp" android:fontFamily="@font/jetbrains_mono" android:paddingTop="4dp" />
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:paddingTop="12dp">
                <TextView android:id="@+id/wolPair" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:background="@drawable/btn_neon" android:gravity="center" android:minHeight="48dp" android:layout_marginEnd="8dp"
                    android:text="Appairer" android:textStyle="bold" android:textColor="@color/accent_on" android:textSize="13sp" />
                <TextView android:id="@+id/wolTest" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:background="@drawable/btn_ghost" android:gravity="center" android:minHeight="48dp" android:layout_marginEnd="8dp"
                    android:text="Tester" android:textStyle="bold" android:textColor="@color/text" android:textSize="13sp" />
                <TextView android:id="@+id/wolForget" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                    android:background="@drawable/btn_outline_danger" android:gravity="center" android:minHeight="48dp"
                    android:text="Oublier…" android:textStyle="bold" android:textColor="@color/danger_soft" android:textSize="13sp" />
            </LinearLayout>
            <TextView android:id="@+id/wolKeyLine" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="" android:textColor="@color/console_text" android:textSize="11sp" android:fontFamily="@font/jetbrains_mono"
                android:background="@drawable/bg_console" android:padding="10dp" android:layout_marginTop="10dp"
                android:textIsSelectable="true" android:visibility="gone" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Repli n8n si wol-pi est injoignable (clé X-PurpleOps-Key)"
                android:textColor="@color/muted" android:textSize="12sp" android:paddingTop="10dp" android:paddingBottom="6dp" />
            <EditText android:id="@+id/cfgWolRelayKey" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/bg_input" android:textColor="@color/text" android:textSize="13sp" android:fontFamily="@font/jetbrains_mono"
                android:hint="vide = repli désactivé" android:textColorHint="@color/faint"
                android:inputType="textPassword" android:maxLines="1" android:importantForAutofill="no" />
            <TextView android:id="@+id/cfgWolRelaySave" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/btn_ghost" android:gravity="center" android:minHeight="46dp" android:layout_marginTop="10dp"
                android:text="Enregistrer la clé du repli" android:textStyle="bold" android:textColor="@color/text" android:textSize="13sp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Webhook n8n (écran Radio)"
                android:textColor="@color/muted" android:textSize="12sp" android:paddingTop="10dp" android:paddingBottom="6dp" />
            <EditText android:id="@+id/cfgRadioUrl" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/bg_input" android:textColor="@color/text" android:textSize="13sp" android:fontFamily="@font/jetbrains_mono" android:hint="https://…/webhook/wids-ctl" android:textColorHint="@color/faint"
                android:inputType="textUri" android:maxLines="1" android:importantForAutofill="no" />
            <TextView android:id="@+id/cfgRadioSave" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/btn_neon" android:gravity="center" android:minHeight="46dp" android:layout_marginTop="10dp"
                android:text="Enregistrer l'URL" android:textStyle="bold" android:textColor="@color/accent_on" android:textSize="13sp" />
        </LinearLayout>

        <!-- À propos -->
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal"
            android:gravity="center_vertical" android:background="@drawable/card" android:padding="16dp">
            <ImageView android:layout_width="36dp" android:layout_height="36dp" android:src="@drawable/ic_logo"
                android:layout_marginEnd="12dp" android:importantForAccessibility="no" />
            <TextView android:id="@+id/cfgVersion" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="" android:textColor="@color/text" android:textSize="12.5sp" android:fontFamily="@font/jetbrains_mono" />
            <TextView android:id="@+id/cfgCheckUpdate" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:background="@drawable/btn_ghost" android:gravity="center" android:minHeight="44dp"
                android:paddingStart="14dp" android:paddingEnd="14dp"
                android:text="Mise à jour" android:textColor="@color/text" android:textStyle="bold" android:textSize="12.5sp" />
        </LinearLayout>
    </LinearLayout>
</ScrollView>
