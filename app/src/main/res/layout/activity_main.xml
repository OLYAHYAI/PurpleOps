<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <FrameLayout
        android:id="@+id/contentArea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include android:id="@+id/viewHome" layout="@layout/view_home"
            android:layout_width="match_parent" android:layout_height="match_parent" />
        <include android:id="@+id/viewAlerts" layout="@layout/view_alerts"
            android:layout_width="match_parent" android:layout_height="match_parent" />
        <include android:id="@+id/viewAssets" layout="@layout/view_assets"
            android:layout_width="match_parent" android:layout_height="match_parent" />
        <include android:id="@+id/viewKali" layout="@layout/view_kali"
            android:layout_width="match_parent" android:layout_height="match_parent" />
        <include android:id="@+id/viewSettings" layout="@layout/view_settings"
            android:layout_width="match_parent" android:layout_height="match_parent" />
    </FrameLayout>

    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/surface"
        app:elevation="0dp"
        app:menu="@menu/bottom_nav"
        app:itemIconTint="@color/nav_item"
        app:itemTextColor="@color/nav_item"
        app:labelVisibilityMode="labeled" />
</LinearLayout>
