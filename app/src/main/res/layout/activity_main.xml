<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg">

    <FrameLayout
        android:id="@+id/contentArea"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <include android:id="@+id/viewHome" layout="@layout/view_home"
            android:layout_width="match_parent" android:layout_height="match_parent" />
        <include android:id="@+id/viewAlerts" layout="@layout/view_alerts"
            android:layout_width="match_parent" android:layout_height="match_parent" />
        <include android:id="@+id/viewAssets" layout="@layout/view_assets"
            android:layout_width="match_parent" android:layout_height="match_parent" />
        <include android:id="@+id/viewKali" layout="@layout/view_kali"
            android:layout_width="match_parent" android:layout_height="match_parent" />
        <include android:id="@+id/viewScreen" layout="@layout/view_screen"
            android:layout_width="match_parent" android:layout_height="match_parent" />
        <include android:id="@+id/viewCamera" layout="@layout/view_camera"
            android:layout_width="match_parent" android:layout_height="match_parent" />
        <include android:id="@+id/viewChat" layout="@layout/view_chat"
            android:layout_width="match_parent" android:layout_height="match_parent" />
        <include android:id="@+id/viewSettings" layout="@layout/view_settings"
            android:layout_width="match_parent" android:layout_height="match_parent" />
    </FrameLayout>

    <!-- Barre flottante « Neon Ops » : pastille arrondie, indicateur actif violet.
         La marge basse suit les insets système (MainActivity). -->
    <com.google.android.material.bottomnavigation.BottomNavigationView
        android:id="@+id/bottomNav"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/bg_nav"
        app:backgroundTint="@null"
        app:elevation="0dp"
        app:menu="@menu/bottom_nav"
        app:itemIconTint="@color/nav_item"
        app:itemTextColor="@color/nav_item"
        app:itemActiveIndicatorStyle="@style/Widget.PurpleOps.NavIndicator"
        app:paddingBottomSystemWindowInsets="false"
        app:labelVisibilityMode="labeled" />
</LinearLayout>
