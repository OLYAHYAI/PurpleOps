<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <!-- En-tête « Opérations » commun à Outils et Radio. -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingBottom="10dp">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:id="@+id/opsKicker" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="OPÉRATIONS · CHROOT KALI" android:textColor="@color/muted" android:textSize="11sp"
                android:fontFamily="@font/jetbrains_mono" android:letterSpacing="0.12" />
            <TextView android:id="@+id/opsTitle" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Kali" android:textColor="@color/text" android:textStyle="bold" android:textSize="22sp" android:fontFamily="@font/space_grotesk" />
        </LinearLayout>
        <TextView android:id="@+id/rootChip" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/chip_root" android:text="ROOT ?" android:textColor="@color/accent_soft"
            android:textSize="11sp" android:fontFamily="@font/jetbrains_mono" />
    </LinearLayout>

    <!-- Sélecteur Outils | Radio | Alfa. Radio = capteur WIDS distant (wol-pi) ;
         Alfa = carte Wi-Fi USB locale du téléphone (RT3070 en OTG). -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:background="@drawable/bg_segment" android:layout_marginBottom="12dp">
        <TextView android:id="@+id/segTools" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp"
            android:gravity="center" android:background="@drawable/seg_item" android:text="Outils"
            android:textColor="@color/seg_text" android:textStyle="bold" android:textSize="13sp" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/segRadio" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp"
            android:gravity="center" android:background="@drawable/seg_item" android:text="Radio"
            android:textColor="@color/seg_text" android:textStyle="bold" android:textSize="13sp" android:clickable="true" android:focusable="true" />
        <TextView android:id="@+id/segAlfa" android:layout_width="0dp" android:layout_weight="1" android:layout_height="40dp"
            android:gravity="center" android:background="@drawable/seg_item" android:text="Alfa"
            android:textColor="@color/seg_text" android:textStyle="bold" android:textSize="13sp" android:clickable="true" android:focusable="true" />
    </LinearLayout>

    <include android:id="@+id/radioView" layout="@layout/view_radio"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:visibility="gone" />

    <include android:id="@+id/alfaView" layout="@layout/view_alfa"
        android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:visibility="gone" />

    <LinearLayout android:id="@+id/kaliTools" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="vertical">

    <EditText android:id="@+id/targetInput" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/bg_input" android:hint="Cible — IP / hôte de TON périmètre" android:fontFamily="@font/jetbrains_mono" android:textSize="13sp"
        android:textColorHint="@color/muted" android:textColor="@color/text" android:inputType="textNoSuggestions"
        android:maxLines="1" android:importantForAutofill="no" />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="8dp" android:paddingBottom="4dp">
        <TextView android:id="@+id/backBtn" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/btn_neon" android:paddingStart="14dp" android:paddingEnd="14dp"
            android:paddingTop="6dp" android:paddingBottom="6dp" android:text="‹" android:textColor="@color/neon"
            android:textSize="16sp" android:visibility="gone" />
        <TextView android:id="@+id/breadcrumb" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:paddingStart="10dp" android:text="Catalogue" android:textColor="@color/accent_soft" android:textSize="12sp" android:fontFamily="@font/jetbrains_mono" />
    </LinearLayout>

    <ScrollView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.3" android:scrollbars="none">
        <LinearLayout android:id="@+id/contentList" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" />
    </ScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingTop="6dp">
        <TextView android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:text="CONSOLE" android:textColor="@color/muted" android:textSize="11sp" android:letterSpacing="0.12" android:fontFamily="@font/jetbrains_mono" />
        <TextView android:id="@+id/stopButton" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/btn_outline_danger" android:paddingStart="14dp" android:paddingEnd="14dp"
            android:paddingTop="8dp" android:paddingBottom="8dp" android:text="STOP" android:textColor="@color/danger_soft" android:fontFamily="@font/jetbrains_mono"
            android:textSize="12sp" android:layout_marginEnd="8dp" />
        <TextView android:id="@+id/clearButton" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/btn_neon" android:paddingStart="16dp" android:paddingEnd="16dp"
            android:paddingTop="8dp" android:paddingBottom="8dp" android:text="CLEAR" android:textColor="@color/text_soft" android:fontFamily="@font/jetbrains_mono" android:textSize="12sp" />
        <TextView android:id="@+id/askSocButton" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/btn_neon" android:paddingStart="16dp" android:paddingEnd="16dp" android:layout_marginStart="8dp"
            android:paddingTop="8dp" android:paddingBottom="8dp" android:text="→ #soc" android:textColor="@color/accent_soft" android:fontFamily="@font/jetbrains_mono" android:textSize="12sp" />
    </LinearLayout>

    <ScrollView android:id="@+id/consoleScroll" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1.2"
        android:background="@drawable/bg_console" android:padding="10dp" android:layout_marginTop="4dp">
        <TextView android:id="@+id/console" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="@font/jetbrains_mono" android:textSize="12sp" android:textColor="@color/console_text" android:textIsSelectable="true" />
    </ScrollView>

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingTop="8dp" android:gravity="center_vertical">
        <EditText android:id="@+id/cmdInput" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:background="@drawable/bg_input" android:hint="commande libre (ex : nmap -A {T})" android:fontFamily="@font/jetbrains_mono" android:textSize="12sp" android:textColorHint="@color/muted"
            android:textColor="@color/text" android:inputType="textNoSuggestions" android:maxLines="1" android:importantForAutofill="no" android:layout_marginEnd="8dp" />
        <TextView android:id="@+id/runButton" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/btn_accent" android:paddingStart="22dp" android:paddingEnd="22dp" android:paddingTop="12dp"
            android:paddingBottom="12dp" android:text="RUN" android:textStyle="bold" android:textColor="#0A0E13" android:textSize="13sp" />
    </LinearLayout>
    </LinearLayout>
</LinearLayout>
