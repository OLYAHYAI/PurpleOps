<?xml version="1.0" encoding="utf-8"?>
<!-- Onglet « Écran » : écran du téléphone piloté depuis le PC par le câble USB (screenctl). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingBottom="10dp">
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="Écran USB" android:textColor="@color/neon"
                android:textStyle="bold" android:textSize="20sp" android:letterSpacing="0.05" />
            <TextView android:id="@+id/scrStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="—" android:textColor="@color/muted" android:textSize="13sp" android:paddingTop="2dp" />
        </LinearLayout>
        <TextView android:id="@+id/scrToggle" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:background="@drawable/btn_accent" android:gravity="center"
            android:paddingStart="20dp" android:paddingEnd="20dp" android:paddingTop="12dp" android:paddingBottom="12dp"
            android:text="ACTIVER" android:textColor="@color/text" android:textStyle="bold" android:textSize="14sp" />
    </LinearLayout>

    <TextView android:id="@+id/scrInfo" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:background="@drawable/tile" android:padding="14dp" android:layout_marginBottom="10dp"
        android:textColor="@color/text" android:textSize="14sp" android:lineSpacingExtra="4dp"
        android:text="Sur le PC : double-clic sur screenview.exe (Release GitHub)." />

    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:paddingBottom="10dp">
        <TextView android:id="@+id/scrPair" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:background="@drawable/btn_neon" android:gravity="center" android:paddingTop="10dp" android:paddingBottom="10dp"
            android:text="APPAIRER UN PC" android:textColor="@color/neon" android:textSize="13sp" android:layout_marginEnd="8dp" />
        <TextView android:id="@+id/scrForget" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
            android:background="@drawable/btn_neon" android:gravity="center" android:paddingTop="10dp" android:paddingBottom="10dp"
            android:text="OUBLIER LES PC" android:textColor="@color/danger" android:textSize="13sp" />
    </LinearLayout>

    <CheckBox android:id="@+id/scrAuto" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Démarrer automatiquement (et laisser tourner quand l'appli est fermée)"
        android:textColor="@color/text" android:textSize="13sp" android:buttonTint="@color/neon"
        android:paddingBottom="6dp" />

    <CheckBox android:id="@+id/scrDim" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="Éteindre l'écran du téléphone pendant le pilotage (économise la batterie)"
        android:textColor="@color/text" android:textSize="13sp" android:buttonTint="@color/neon"
        android:paddingBottom="6dp" />

    <TextView android:id="@+id/scrPcs" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:text="PC appairés : —" android:textColor="@color/muted" android:textSize="12sp" android:paddingBottom="8dp" />

    <ScrollView android:id="@+id/scrLogScroll" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:background="@drawable/bg_console" android:padding="10dp">
        <TextView android:id="@+id/scrLog" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:fontFamily="monospace" android:textSize="11sp" android:textColor="@color/console_text"
            android:textIsSelectable="true" />
    </ScrollView>
</LinearLayout>
