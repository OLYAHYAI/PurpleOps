<?xml version="1.0" encoding="utf-8"?>
<!-- Chat SOC (#soc:maison) : même salon qu'Element X, construit par ChatPanel.kt.
     Pas d'onglet dédié (barre plafonnée à 5) : ouvert depuis l'Accueil. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">

    <!-- En-tête : salon Matrix (même salon qu'Element X). -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:gravity="center_vertical" android:paddingBottom="12dp">
        <TextView android:id="@+id/chatBack" android:layout_width="40dp" android:layout_height="40dp"
            android:gravity="center" android:background="@drawable/btn_neon" android:layout_marginEnd="12dp"
            android:text="#" android:textColor="@color/accent_soft" android:textSize="17sp" android:fontFamily="@font/jetbrains_mono"
            android:importantForAccessibility="no" />
        <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="soc:maison" android:textColor="@color/text" android:textSize="17sp"
                android:fontFamily="@font/space_grotesk" android:textStyle="bold" />
            <TextView android:id="@+id/chatStatus" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="…" android:textColor="@color/muted" android:textSize="11sp" android:fontFamily="@font/jetbrains_mono" />
        </LinearLayout>
        <TextView android:id="@+id/chatMenu" android:layout_width="40dp" android:layout_height="40dp" android:gravity="center"
            android:background="@drawable/btn_ghost" android:contentDescription="Menu du salon"
            android:text="⋮" android:textColor="@color/text_soft" android:textSize="18sp" />
    </LinearLayout>

    <!-- Connexion (session dédiée « PurpleOps ») -->
    <ScrollView android:id="@+id/chatLogin" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:visibility="gone">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="Connexion au salon SOC. L'appli ouvre sa propre session Matrix (appareil « PurpleOps »), révocable seule. Le mot de passe n'est pas conservé ; le jeton est chiffré par le Keystore."
                android:textColor="@color/muted" android:textSize="12sp" android:paddingBottom="12dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Serveur"
                android:textColor="@color/muted" android:textSize="12sp" />
            <EditText android:id="@+id/chatHs" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/bg_input" android:textColor="@color/text" android:textSize="14sp"
                android:inputType="textUri" android:singleLine="true" android:layout_marginBottom="10dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Utilisateur"
                android:textColor="@color/muted" android:textSize="12sp" />
            <EditText android:id="@+id/chatUser" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/bg_input" android:textColor="@color/text" android:textSize="14sp"
                android:inputType="text" android:singleLine="true" android:layout_marginBottom="10dp" />
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Mot de passe"
                android:textColor="@color/muted" android:textSize="12sp" />
            <EditText android:id="@+id/chatPass" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/bg_input" android:textColor="@color/text" android:textSize="14sp"
                android:inputType="textPassword" android:singleLine="true" android:layout_marginBottom="14dp" />
            <TextView android:id="@+id/chatConnect" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:background="@drawable/btn_accent" android:gravity="center" android:paddingTop="12dp" android:paddingBottom="12dp"
                android:text="CONNECTER" android:textColor="@color/bg" android:textStyle="bold" android:textSize="13sp" />
            <TextView android:id="@+id/chatLoginStatus" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="" android:textColor="@color/muted" android:textSize="12sp" android:fontFamily="@font/jetbrains_mono" android:paddingTop="10dp" />
        </LinearLayout>
    </ScrollView>

    <!-- Fil du salon -->
    <LinearLayout android:id="@+id/chatRoom" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:orientation="vertical">
        <ScrollView android:id="@+id/chatScroll" android:layout_width="match_parent" android:layout_height="0dp"
            android:layout_weight="1" android:scrollbars="none">
            <LinearLayout android:id="@+id/chatList" android:layout_width="match_parent" android:layout_height="wrap_content"
                android:orientation="vertical" android:paddingBottom="6dp" />
        </ScrollView>

        <LinearLayout android:id="@+id/chatReplyBar" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="center_vertical" android:background="@drawable/bg_input"
            android:layout_marginBottom="6dp" android:visibility="gone">
            <TextView android:id="@+id/chatReplyText" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:text="" android:textColor="@color/muted" android:textSize="12sp" android:maxLines="2" android:ellipsize="end" />
            <TextView android:id="@+id/chatReplyCancel" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:text="✕" android:textColor="@color/accent_soft" android:textSize="16sp" android:paddingStart="12dp"
                android:contentDescription="Annuler la réponse" />
        </LinearLayout>

        <HorizontalScrollView android:layout_width="match_parent" android:layout_height="wrap_content" android:scrollbars="none"
            android:paddingBottom="6dp">
            <LinearLayout android:id="@+id/chatAgents" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:orientation="horizontal" />
        </HorizontalScrollView>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="horizontal" android:gravity="bottom" android:paddingTop="8dp">
            <EditText android:id="@+id/chatInput" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content"
                android:background="@drawable/bg_input" android:textColor="@color/text" android:textColorHint="@color/muted"
                android:textSize="14sp" android:hint="Écrire à #soc… (@agent pour solliciter)"
                android:inputType="textMultiLine|textCapSentences" android:maxLines="5" android:maxLength="4000" />
            <TextView android:id="@+id/chatSend" android:layout_width="48dp" android:layout_height="48dp"
                android:background="@drawable/btn_accent" android:gravity="center" android:layout_marginStart="8dp"
                android:text="➤" android:textColor="@color/bg" android:textSize="17sp" android:contentDescription="Envoyer" />
        </LinearLayout>
    </LinearLayout>
</LinearLayout>
