{
  "version": 3,
  "categories": [
    {
      "name": "Recon",
      "tools": [
        {
          "name": "nmap",
          "desc": "Scan reseau / ports / services",
          "actions": [
            { "label": "Services (-sV)", "cmd": "nmap -sV {T}" },
            { "label": "Scripts defaut (-sC)", "cmd": "nmap -sC {T}" },
            { "label": "Ping sweep (-sn)", "cmd": "nmap -sn {T}" },
            { "label": "Quick (-T4 -F)", "cmd": "nmap -T4 -F {T}" },
            { "label": "Full (-sV -sC -p-)", "cmd": "nmap -sV -sC -p- {T}" },
            { "label": "Vuln (--script vuln)", "cmd": "nmap -sV --script vuln {T}" },
            { "label": "Perso", "cmd": "nmap {OPTS} {T}", "params": [ { "name": "OPTS", "hint": "options nmap", "default": "-A" } ] }
          ]
        },
        {
          "name": "masscan",
          "desc": "Scan de ports tres rapide",
          "actions": [
            { "label": "Installer", "cmd": "apt install -y masscan" },
            { "label": "Tous les ports", "cmd": "masscan {T} -p1-65535 --rate 1000" }
          ]
        },
        {
          "name": "hote",
          "desc": "Infos du chroot / identite",
          "actions": [
            { "label": "id + uname", "cmd": "id; uname -a" },
            { "label": "ip", "cmd": "ip -brief addr 2>/dev/null || ifconfig" }
          ]
        }
      ]
    },
    {
      "name": "DNS",
      "tools": [
        {
          "name": "dnsrecon",
          "desc": "Enumeration DNS",
          "actions": [
            { "label": "Installer", "cmd": "apt install -y dnsrecon" },
            { "label": "Standard", "cmd": "dnsrecon -d {DOM}", "params": [ { "name": "DOM", "hint": "domaine (ex: lab.local)", "default": "" } ] },
            { "label": "Reverse /24", "cmd": "dnsrecon -r {T}/24" }
          ]
        },
        {
          "name": "dnsenum",
          "desc": "Enumeration DNS (alternative)",
          "actions": [
            { "label": "Installer", "cmd": "apt install -y dnsenum" },
            { "label": "Scan", "cmd": "dnsenum {DOM}", "params": [ { "name": "DOM", "hint": "domaine", "default": "" } ] }
          ]
        }
      ]
    },
    {
      "name": "Web",
      "tools": [
        {
          "name": "nikto",
          "desc": "Scanner de vulns serveur web",
          "actions": [
            { "label": "Installer", "cmd": "apt install -y nikto" },
            { "label": "Scan", "cmd": "nikto -host {T}" }
          ]
        },
        {
          "name": "gobuster",
          "desc": "Bruteforce de repertoires/DNS",
          "actions": [
            { "label": "Installer", "cmd": "apt install -y gobuster" },
            { "label": "Dirs (common)", "cmd": "gobuster dir -u http://{T} -w /usr/share/wordlists/dirb/common.txt" }
          ]
        },
        {
          "name": "whatweb",
          "desc": "Empreinte techno d'un site",
          "actions": [
            { "label": "Installer", "cmd": "apt install -y whatweb" },
            { "label": "Scan", "cmd": "whatweb {T}" }
          ]
        },
        {
          "name": "sqlmap",
          "desc": "Injection SQL",
          "actions": [
            { "label": "Installer", "cmd": "apt install -y sqlmap" },
            { "label": "Test URL", "cmd": "sqlmap -u {URL} --batch", "params": [ { "name": "URL", "hint": "http://cible/page?id=1", "default": "" } ] }
          ]
        }
      ]
    },
    {
      "name": "TLS / SSH",
      "tools": [
        {
          "name": "sslscan",
          "desc": "Posture TLS/SSL d'un service",
          "actions": [
            { "label": "Installer", "cmd": "apt install -y sslscan" },
            { "label": "Scan (443)", "cmd": "sslscan {T}" }
          ]
        },
        {
          "name": "ssh-audit",
          "desc": "Audit de config SSH",
          "actions": [
            { "label": "Installer", "cmd": "apt install -y ssh-audit" },
            { "label": "Audit", "cmd": "ssh-audit {T}" }
          ]
        }
      ]
    },
    {
      "name": "SMB",
      "tools": [
        {
          "name": "smbclient",
          "desc": "Lister les partages SMB",
          "actions": [
            { "label": "Installer", "cmd": "apt install -y smbclient" },
            { "label": "Liste (null session)", "cmd": "smbclient -L //{T} -N" }
          ]
        },
        {
          "name": "smbmap",
          "desc": "Enumeration des partages + droits",
          "actions": [
            { "label": "Installer", "cmd": "apt install -y smbmap" },
            { "label": "Scan", "cmd": "smbmap -H {T}" }
          ]
        }
      ]
    },
    {
      "name": "Brute",
      "tools": [
        {
          "name": "hydra",
          "desc": "Bruteforce d'authentification (T1110)",
          "actions": [
            { "label": "SSH", "cmd": "hydra -l {USER} -P {WORDLIST} ssh://{T}", "params": [ { "name": "USER", "hint": "login", "default": "root" }, { "name": "WORDLIST", "hint": "chemin wordlist", "default": "/usr/share/wordlists/rockyou.txt" } ] },
            { "label": "FTP", "cmd": "hydra -l {USER} -P {WORDLIST} ftp://{T}", "params": [ { "name": "USER", "hint": "login", "default": "admin" }, { "name": "WORDLIST", "hint": "chemin wordlist", "default": "/usr/share/wordlists/rockyou.txt" } ] }
          ]
        }
      ]
    },
    {
      "name": "Reseau / Routeur",
      "tools": [
        {
          "name": "nbtscan",
          "desc": "Enumeration NetBIOS",
          "actions": [
            { "label": "Installer", "cmd": "apt install -y nbtscan" },
            { "label": "Scan /24", "cmd": "nbtscan {T}/24" }
          ]
        },
        {
          "name": "snmp",
          "desc": "Reconnaissance SNMP",
          "actions": [
            { "label": "Installer", "cmd": "apt install -y onesixtyone snmp" },
            { "label": "Communaute (onesixtyone)", "cmd": "onesixtyone {T} public" },
            { "label": "Walk (public)", "cmd": "snmpwalk -v2c -c public {T}" }
          ]
        },
        {
          "name": "routersploit",
          "desc": "Exploitation box / routeurs / IoT (IP)",
          "actions": [
            { "label": "Installer", "cmd": "apt install -y routersploit" },
            { "label": "Autopwn", "cmd": "rsf.py -m scanners/autopwn -s target={T} -s run 2>/dev/null || echo 'lancer rsf.py manuellement'" }
          ]
        },
        {
          "name": "enum4linux",
          "desc": "Enumeration SMB/Windows",
          "actions": [
            { "label": "Installer", "cmd": "apt install -y enum4linux" },
            { "label": "Enum complet", "cmd": "enum4linux -a {T}" }
          ]
        }
      ]
    },
    {
      "name": "Wifi (radio)",
      "tools": [
        {
          "name": "info",
          "desc": "Pourquoi le radio-layer est indisponible ici",
          "actions": [
            { "label": "Lire la limite", "cmd": "echo 'Monitor mode / injection (aircrack-ng, wifite, airgeddon) necessitent le noyau NetHunter ou un adaptateur USB OTG compatible. Indisponible sur noyau stock en chroot. Alternatives IP : voir categorie Reseau/Routeur (nmap scripts, routersploit).'" }
          ]
        }
      ]
    },
    {
      "name": "Exploit",
      "tools": [
        {
          "name": "metasploit",
          "desc": "Framework (CLI, sans base de donnees)",
          "actions": [
            { "label": "Version", "cmd": "msfconsole --version" },
            { "label": "searchsploit", "cmd": "searchsploit {Q}", "params": [ { "name": "Q", "hint": "mot-cle (ex: vsftpd)", "default": "" } ] }
          ]
        }
      ]
    }
  ]
}
